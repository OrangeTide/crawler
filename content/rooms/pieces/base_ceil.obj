# A 1x1 base ceiling tile for the mossy kit: the floor quad wound the other
# way so it faces down, sampling the same per-unit brick slice. Y-up, the
# bake converts to Z-up. Centred on the cell, placed at the ceiling height.
v -0.5 0 -0.5
v 0.5 0 -0.5
v 0.5 0 0.5
v -0.5 0 0.5
vt 0.230800 0.102200
vt 0.381030 0.102200
vt 0.381030 0.177300
vt 0.230800 0.177300
vn 0 -1 0
g base_ceil
usemtl trim sheet
f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1
